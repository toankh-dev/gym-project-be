{
  "watch": ["src"],
  "ext": "ts,json",
  "ignore": ["src/**/*.test.ts", "node_modules", "dist"],
  "exec": "node --inspect=0.0.0.0:9229 -r ts-node/register -r tsconfig-paths/register -r dotenv/config src/index.ts",
  "env": {
    "NODE_ENV": "development",
    "TS_NODE_TRANSPILE_ONLY": "true"
  }
}