# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gym_management_system
DB_USER=gym_user
DB_PASSWORD=secure_password123

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password123
REDIS_PREFIX=gym:

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars_long
JWT_EXPIRE=24h
JWT_REFRESH_SECRET=your_refresh_secret_key_here_min_32_chars_long
JWT_REFRESH_EXPIRE=7d

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME=Gym Management System
SMTP_FROM_EMAIL=noreply@gymmanagement.com

# File Upload Configuration
UPLOAD_LIMIT=10mb
UPLOAD_PATH=/uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret_here_min_32_chars_long
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Application Settings
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Development Settings (only for dev environment)
ENABLE_SWAGGER=true
ENABLE_DEBUG=true
MOCK_EMAIL=true